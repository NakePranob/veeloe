{
  "name": "veeloe",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["controller-prototype"],
  "scripts": {
    "test": "cd controller-prototype && bun test",
    "check": "bun run typecheck && bun run check:prototype",
