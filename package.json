{
  "name": "veeloe",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*", "controller", "controller-prototype", "e2e"],
  "scripts": {
    "test": "cd packages && bun test && cd ../controller-prototype && bun test && cd ../controller && bun test ./src ./scripts",
    "test:e2e": "cd e2e && bun test",
    "check": "bun run typecheck && bun run check:prototype && bun run check:controller && bun run check:hub",
    "typecheck": "tsc --noEmit && tsc --noEmit -p controller-prototype && tsc --noEmit -p controller",
    "check:prototype": "cd controller-prototype && steiger ./src",
    "check:hub": "cd hub && go-scaffold check",
    "prototype": "cd controller-prototype && bunx expo start --web",
    "check:controller": "cd controller && steiger ./src && bun scripts/check-i18n.ts"
  },
  "devDependencies": {
    "@nakedev/go-scaffold": "0.14.0",
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.3"
  }
}
