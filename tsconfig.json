{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/*/src/**/*.ts", "e2e/**/*.ts", "controller-prototype/src/**/*.test.ts", "controller/src/**/*.test.ts", "controller/scripts/**/*.ts"]
}
